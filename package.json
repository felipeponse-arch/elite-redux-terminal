{
  "name": "elite-redux-terminal-ci",
  "private": true,
  "version": "1.0.0",
  "description": "Infraestrutura de CI do Elite Redux Terminal - não é dependência do artifact publicado, só do processo de build/teste local e no GitHub Actions.",
  "scripts": {
    "check:encoding": "node scripts/checar_encoding.mjs",
    "check:sintaxe": "node scripts/checar_sintaxe.mjs",
    "lint": "eslint . artifact_template.html",
    "check:tipos": "tsc -p tsconfig.json",
    "build": "node scripts/build.mjs",
    "mapa": "node scripts/mapa_do_codigo.mjs",
    "verificar": "node scripts/verificar.mjs",
    "encalhados": "node scripts/encalhados.mjs",
    "checkpoint": "node scripts/checkpoint.mjs",
    "pesado": "node scripts/vaga.mjs",
    "alarme:upstream": "node scripts/alarme_upstream.mjs",
    "diff:versoes": "node scripts/diff_versoes.mjs",
    "validar:cru": "node scripts/validar_dado_cru.mjs",
    "lint:css": "stylelint \"src/css/*.css\" && node scripts/checar_css.mjs",
    "check": "node scripts/checar_paralelo.mjs",
    "check:serie": "node scripts/checar_encoding.mjs && node scripts/checar_sintaxe.mjs && eslint . artifact_template.html && stylelint \"src/css/*.css\" && node scripts/checar_css.mjs && node scripts/checar_fronteira.mjs && tsc -p tsconfig.json",
    "test:unit": "npm run pesado -- node --test \"tests/unit/*.test.mjs\"",
    "test:sabotage": "node tests/run_sabotage.mjs",
    "test:e2e": "playwright test --project=funcional",
    "test:visual": "playwright test --project=visual",
    "test:relatorio": "playwright show-report"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "eslint": "10.12.0",
    "globals": "17.12.0",
    "stylelint": "17.15.0",
    "stylelint-config-recommended": "18.0.0",
    "typescript": "7.0.2"
  }
}
