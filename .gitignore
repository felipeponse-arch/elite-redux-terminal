# Build output - regenerated deterministically by scripts/build.mjs (npm run build) from the
# template + data/*.json + data/sprite_atlas.png. Not source, so not tracked.
artifact_final.html

# Cache of the ~1900 raw 64px sprite PNGs downloaded from NextDex, used only
# to avoid re-downloading when scripts/build_sprite_atlas.ps1 rebuilds
# data/sprite_atlas.png (which IS tracked - it's the actual build input).
# Regenerates automatically (re-downloads any missing file) if deleted.
data/sprites_all/

# CI infra (package.json/tests/, 2026-09-13): node_modules is reinstalled
# fresh by `npm install` (both locally and in the GitHub Actions workflow),
# never tracked, same reasoning as any other npm project. package-lock.json
# is NOT ignored - it IS meant to be committed once generated - but doesn't
# exist yet in this repo (no Node available to generate it in the session
# that wrote this CI setup).
node_modules/

# Saída do Playwright (fase 6, 2026-09-24): prints, traces e diferenças visuais
# das falhas (test-results/) e o relatório HTML (playwright-report/). Só as
# referências em tests/visual_baselines/ são fonte; isto é gerado a cada execução.
test-results*/
playwright-report*/

# Cache do teste de sabotagem (2026-09-30): qual arquivo de teste pegou cada
# sabotagem na última rodada. Só atalho - apagar não muda o resultado.
tests/.sabotagem_cache.json

# Worktrees das sessões do Claude Code (02/10: uma worktree dentro do repo fazia o
# lint varrer a cópia inteira e derrubava o npm run check de todo mundo).
.claude/worktrees/
# Memória própria dos agentes do Claude Code (não é código do app).
.claude/agent-memory/

# Grafo do código do Graphify (setup do toolkit, 17/10/2026): gerado por comando, não é fonte.
graphify-out/
graphify-in/
